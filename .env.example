# Copie para .env (local) ou cadastre como variaveis de ambiente no hPanel (Hostinger).
# NUNCA versione o arquivo .env preenchido.

# Senha do painel administrativo (admin.html). Minimo 12 caracteres.
ADMIN_PASSWORD=troque-esta-senha-por-forte

# Porta do servidor. Na Hostinger o hPanel define PORT automaticamente; comeca em 4173.
PORT=4173

# Pasta de dados (cardapio, pedidos, bairros, chave Pix, hash da senha).
# Na Hostinger aponte para uma pasta FORA do repositorio, para nao perder pedidos no proximo deploy.
DATA_DIR=data

# Pasta das fotos enviadas pelo painel admin.
# Na Hostinger aponte para uma pasta FORA do repositorio (as fotos do cardapio ja vao no repo).
UPLOAD_DIR=uploads
