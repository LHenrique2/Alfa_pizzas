# Copie para .env (local) ou cadastre como variaveis de ambiente no hPanel (Hostinger).
# NUNCA versione o arquivo .env preenchido.

# Senha do painel administrativo (admin.html). Minimo 12 caracteres.
ADMIN_PASSWORD=troque-esta-senha-por-forte

# Porta do servidor. Na Hostinger o hPanel define PORT automaticamente; comeca em 4173.
PORT=4173

# Pasta de dados (cardapio, pedidos, bairros, chave Pix, hash da senha).
# Na Hostinger aponte para uma pasta FORA do repositorio, para nao perder pedidos no proximo deploy.
DATA_DIR=data

# Pasta das fotos enviadas pelo painel admin.
# Na Hostinger aponte para uma pasta FORA do repositorio (as fotos do cardapio ja vao no repo).
UPLOAD_DIR=uploads

# --- Persistencia via GitHub (opcional, mas recomendado em disco efemero) ---
# Habilita o espelhamento de data/ e uploads/ na branch de dados do repositorio.
# Sem GITHUB_TOKEN e GITHUB_REPO o recurso fica desligado.
# GITHUB_TOKEN: token fine-grained do GitHub com permissao "Contents: Read and write"
# apenas no repositorio LHenrique2/Alfa_pizzas.
#GITHUB_TOKEN=
#GITHUB_REPO=LHenrique2/Alfa_pizzas
# Branch onde os dados sao espelhados (nao e a branch de deploy, entao nao gera deploy).
#GITHUB_DATA_BRANCH=alpha-data
# Branch usada no deploy (main ou master). Se omitida, o servidor detecta.
#GITHUB_DEPLOY_BRANCH=main
